# Serene — Environment Variables
# Copy this file to .env.local and fill in real values before running the app.
# .env.local is gitignored — NEVER commit real keys to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: Supabase dashboard → Settings → API
# Note: NEXT_PUBLIC_ prefix required for browser-accessible vars in Next.js
NEXT_PUBLIC_SERENE_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SERENE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-only, never expose to the browser
SERENE_SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
# Model in use: claude-sonnet-4-20250514 (see .cursorrules section 9)
SERENE_ANTHROPIC_API_KEY=sk-ant-...

# ─── Cloudflare R2 (Phase 3 — not needed until post creation) ────────────────
SERENE_R2_BUCKET_URL=
SERENE_R2_ACCESS_KEY_ID=
SERENE_R2_SECRET_ACCESS_KEY=

# ─── Cloudflare Stream (Phase 5 — not needed until video posts) ──────────────
SERENE_CLOUDFLARE_STREAM_TOKEN=
SERENE_CLOUDFLARE_ACCOUNT_ID=
